preferred-citation:
  type: conference-paper
  title: "DataGenX V2"
  authors:
    - family-names: Ramanavarapu
      given-names: Sreeharsha
  collection-title: >-
    Performance Evaluation and Benchmarking (TPCTC 2026)
  year: 2026
