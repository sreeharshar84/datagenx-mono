# Copy to .env at the repository root and fill in. .env is gitignored.
#
# The engine binary is resolved from this repository (target/release/dbgen)
# and needs no configuration.

DB_TYPE=mysql
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=

# Schemas. TARGET_SCHEMA defaults to <SOURCE_SCHEMA>_dbgenx.
SOURCE_SCHEMA=tpch
# TARGET_SCHEMA=tpch_dbgenx

# Location of the official TPC-H kit (dbgen, dists.dss, queries).
# Defaults to ../tpch/tpch-dbgen relative to this repository.
# TPCH_DBGEN_DIR=/path/to/tpch-dbgen

# --- TiDB / SingleStore instead of local MySQL ---
# DB_TYPE=tidb
# TIDB_HOST=gateway.region.prod.aws.tidbcloud.com
# TIDB_PORT=4000
# TIDB_USERNAME=xxxxxxxx.root
# TIDB_PASSWORD=
# TIDB_DATABASE=test
